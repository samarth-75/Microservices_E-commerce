# ============================================================
# CommerceSphere — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — only .env.example goes in version control.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=commercesphere
POSTGRES_PASSWORD=changeme_pg
POSTGRES_DB=commercesphere
POSTGRES_PORT=5432

# ---- MongoDB ----
MONGO_INITDB_ROOT_USERNAME=commercesphere
MONGO_INITDB_ROOT_PASSWORD=changeme_mongo
MONGO_PORT=27017

# ---- Redis ----
REDIS_PORT=6379

# ---- RabbitMQ ----
RABBITMQ_DEFAULT_USER=commercesphere
RABBITMQ_DEFAULT_PASS=changeme_rabbit
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---- API Gateway ----
GATEWAY_PORT=3000
