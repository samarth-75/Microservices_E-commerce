# ============================================================
# CommerceSphere — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — only .env.example goes in version control.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=commercesphere
POSTGRES_PASSWORD=changeme_pg
POSTGRES_DB=commercesphere
POSTGRES_PORT=5432

# ---- MongoDB ----
MONGO_INITDB_ROOT_USERNAME=commercesphere
MONGO_INITDB_ROOT_PASSWORD=changeme_mongo
MONGO_PORT=27017

# ---- Redis ----
REDIS_PORT=6379

# ---- RabbitMQ ----
RABBITMQ_DEFAULT_USER=commercesphere
RABBITMQ_DEFAULT_PASS=changeme_rabbit
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---- API Gateway ----
GATEWAY_PORT=3000

# ---- Auth Service ----
AUTH_DB_NAME=commercesphere_auth
JWT_ACCESS_SECRET=changeme_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=changeme_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Catalog Service ----
CATALOG_DB_NAME=commercesphere_catalog
CATALOG_SERVICE_PORT=3002

# ---- Cart Service ----
CART_SERVICE_PORT=3003
GUEST_CART_TTL=604800
USER_CART_TTL=2592000
