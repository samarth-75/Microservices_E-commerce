# ============================================================
# CommerceSphere — Cart Service Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — only .env.example goes in version control.
# ============================================================

PORT=3003
NODE_ENV=development

# ---- Redis (primary data store for cart — NOT just a cache) ----
REDIS_URL=redis://localhost:6379

# ---- JWT (same access secret as auth-service for token verification) ----
JWT_ACCESS_SECRET=changeme_access_secret_at_least_32_chars

# ---- Catalog Service (for product validation via REST) ----
CATALOG_SERVICE_URL=http://localhost:3002

# ---- Cart TTL (seconds) ----
GUEST_CART_TTL=604800
USER_CART_TTL=2592000
