# ============================================================
# Payment Service — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

PORT=3006
NODE_ENV=development

# ---- PostgreSQL connection ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=commercesphere_payments
DB_USER=commercesphere
DB_PASSWORD=changeme_pg

# ---- JWT secret (must match auth-service) ----
JWT_ACCESS_SECRET=changeme_access_secret_at_least_32_chars

# ---- Stripe (sandbox/test mode) ----
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me_with_real_key
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# ---- Stripe Checkout redirect URLs ----
STRIPE_SUCCESS_URL=http://localhost:5173/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/checkout/cancel

# ---- Cross-service URLs ----
ORDER_SERVICE_URL=http://localhost:3004
