# ============================================================
# Auth Service — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

PORT=3001
NODE_ENV=development

# ---- PostgreSQL connection ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=commercesphere_auth
DB_USER=commercesphere
DB_PASSWORD=changeme_pg

# ---- JWT secrets ----
# Use long, random strings in production (e.g. openssl rand -hex 64)
JWT_ACCESS_SECRET=changeme_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=changeme_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
