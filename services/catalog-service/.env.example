# ============================================================
# CommerceSphere — Catalog Service Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — only .env.example goes in version control.
# ============================================================

PORT=3002
NODE_ENV=development

# ---- MongoDB ----
MONGO_URI=mongodb://commercesphere:changeme_mongo@localhost:27017/commercesphere_catalog?authSource=admin

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT (same access secret as auth-service for token verification) ----
JWT_ACCESS_SECRET=changeme_access_secret_at_least_32_chars

# ---- Image Upload ----
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_UPLOAD=5
