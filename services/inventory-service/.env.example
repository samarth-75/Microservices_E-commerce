# ============================================================
# Inventory Service — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

PORT=3005
NODE_ENV=development

# ---- PostgreSQL connection ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=commercesphere_inventory
DB_USER=commercesphere
DB_PASSWORD=changeme_pg

# ---- JWT secret (must match auth-service) ----
JWT_ACCESS_SECRET=changeme_access_secret_at_least_32_chars

# ---- RabbitMQ ----
RABBITMQ_URL=amqp://commercesphere:changeme_rabbit@localhost:5672
